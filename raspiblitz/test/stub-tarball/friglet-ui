#!/usr/bin/env python3
"""TEST STUB of friglet-ui. It is not the real program.

It implements just enough of docs/contract.md for the RaspiBlitz bonus script test:
--version, `password set` (stdin), and the daemon (`run`): environment checks, the
loopback web listener with /api/widget and /healthz, and the two Electrum listeners
(bound only, no protocol). It records its FRIGLET_UI_* environment for assertions.
"""
import hashlib
import http.server
import json
import os
import signal
import socket
import socketserver
import sys
import time

VERSION = "0.0.0-stub"


def die(msg, code=64):
    print(msg, file=sys.stderr)
    sys.exit(code)


def write_private(path, text):
    old = os.umask(0o077)
    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
    finally:
        os.umask(old)


def host_port(value):
    host, port = value.rsplit(":", 1)
    return host, int(port)


args = sys.argv[1:]
if args[:1] == ["--version"]:
    print("friglet-ui", VERSION)
    sys.exit(0)

data = os.environ.get("FRIGLET_UI_DATA_DIR", "/data")

if args[:2] == ["password", "set"]:
    pw = sys.stdin.read().strip()
    if not pw:
        die("empty password on stdin", 2)
    write_private(os.path.join(data, "stub-ui-password.sha256"), hashlib.sha256(pw.encode()).hexdigest())
    with open(os.path.join(data, "stub-sessions-ended"), "a", encoding="utf-8") as f:
        f.write(f"{time.time()}\n")
    sys.exit(0)

if args and args[0] != "run":
    die(f"stub friglet-ui: unsupported arguments {args}", 2)

for key in os.environ:
    if key.startswith("FRIGLET_") and not key.startswith("FRIGLET_UI_"):
        die(f"{key} is set in the environment", 64)
for key in ("FRIGLET_UI_NETWORK", "FRIGLET_UI_NODE"):
    if not os.environ.get(key):
        die(f"{key} is required", 64)

friglet_bin = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "friglet")
if not os.access(friglet_bin, os.X_OK):
    die(f"friglet not found next to friglet-ui: {friglet_bin}", 64)

if os.environ.get("FRIGLET_UI_AUTH", "password") == "password":
    pw_file = os.environ.get("FRIGLET_UI_PASSWORD_FILE")
    if not pw_file:
        die("FRIGLET_UI_PASSWORD_FILE is not set", 64)
    with open(pw_file, encoding="utf-8") as f:
        pw = f.read().strip()
    if not pw:
        die("password file is empty", 64)
    write_private(os.path.join(data, "stub-ui-password.sha256"), hashlib.sha256(pw.encode()).hexdigest())

env = {k: v for k, v in os.environ.items() if k.startswith("FRIGLET_UI_")}
env["_uid"] = os.getuid()
env["_umask"] = oct(os.umask(0o077))
write_private(os.path.join(data, "stub-env.json"), json.dumps(env, indent=1, sort_keys=True))


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/api/widget":
            body = json.dumps({"state": "scanning", "scanned_height": 850000, "tip_height": 900000}).encode()
            ctype = "application/json"
        elif self.path == "/healthz":
            body, ctype = b"ok", "text/plain"
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_):
        pass


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


server = Server(host_port(os.environ.get("FRIGLET_UI_LISTEN", "127.0.0.1:8097")), Handler)
listeners = []
for key, default in (("FRIGLET_UI_ELECTRUM_TCP", "0.0.0.0:50031"), ("FRIGLET_UI_ELECTRUM_TLS", "0.0.0.0:50032")):
    value = os.environ.get(key, default)
    if value == "off":
        continue
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(host_port(value))
    sock.listen()
    listeners.append(sock)


def stop(*_):
    with open(os.path.join(data, "stub-stops"), "a", encoding="utf-8") as f:
        f.write(f"{time.time()}\n")
    os._exit(0)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
print("stub friglet-ui serving", flush=True)
server.serve_forever()
