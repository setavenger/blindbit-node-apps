@@ -45,6 +46,7 @@ OPTIONS=()
 if [ "${network}" == "bitcoin" ]; then
   OPTIONS+=(ea 'BTC Electrum Rust Server' ${ElectRS})
   OPTIONS+=(fu 'BTC Fulcrum Electrum Server' ${fulcrum})
+  OPTIONS+=(fg 'BTC friglet Silent Payments Scanner' "${friglet}")
   OPTIONS+=(pa 'BTC PayServer' ${BTCPayServer})
   OPTIONS+=(ba 'BTC RPC-Explorer' ${BTCRPCexplorer})
   OPTIONS+=(sa 'BTC Specter Desktop' ${specter})
@@ -306,6 +308,37 @@ else
   echo "Fulcrum Setting unchanged."
 fi
 
+# friglet process choice
+choice="off"; check=$(echo "${CHOICES}" | grep -c "fg")
+if [ "${check}" -eq 1 ]; then choice="on"; fi
+if [ "${friglet}" != "${choice}" ]; then
+  echo "friglet setting changed .."
+  anychange=1
+  if [ "${choice}" = "on" ]; then
+    if sudo -u admin /home/admin/config.scripts/bonus.friglet.sh on; then
+      sudo -u admin /home/admin/config.scripts/bonus.friglet.sh menu
+    else
+      echo "# friglet was not switched on - see the messages above."
+      echo "Press ENTER to continue."
+      read -r
+    fi
+  else
+    whiptail --title "Delete friglet data?" \
+      --yes-button "Keep Data" \
+      --no-button "Delete Data" \
+      --yesno "friglet is getting uninstalled. Keep its data (wallet setup, scan state, web UI password) to reuse it on a re-install? Deleting also removes the wallet's scan key from this node." 11 70
+    if [ $? -eq 1 ]; then
+      echo "# Uninstalling friglet AND DELETING DATA ..."
+      sudo -u admin /home/admin/config.scripts/bonus.friglet.sh off --delete-data
+    else
+      echo "# Uninstalling friglet but keeping data ..."
+      sudo -u admin /home/admin/config.scripts/bonus.friglet.sh off
+    fi
+  fi
+else
+  echo "friglet setting unchanged."
+fi
+
 # BTCPayServer process choice
 choice="off"; check=$(echo "${CHOICES}" | grep -c "pa")
 if [ ${check} -eq 1 ]; then choice="on"; fi
