# friglet-node with Docker Compose. Copy to .env, fill in the three required values, then
#   docker compose up -d
# Only FRIGLET_UI_* variables reach the container; the rest is for Compose itself.

# --- required -------------------------------------------------------------------------------
# Network of your Bitcoin node: bitcoin, signet, testnet4 or regtest.
FRIGLET_UI_NETWORK=signet
# Your node's P2P address as host:port. It must be an unpruned, synced node that holds every
# block from your wallet's birthday onward. host.docker.internal is this Docker host.
FRIGLET_UI_NODE=host.docker.internal:38333
# Password for the web page (http://<this host>:8097). Change it.
FRIGLET_UI_PASSWORD=change-me-to-something-long

# --- optional -------------------------------------------------------------------------------
# Oracle (BlindBit gRPC). Defaults: https://oracle.setor.dev (bitcoin),
# https://signet.oracle.setor.dev (signet). A third-party service: it sees this host's IP and
# which block ranges are scanned, never keys.
#FRIGLET_UI_ORACLE_URL=
# Host name shown on the Connect page, e.g. mybox.local.
#FRIGLET_UI_PUBLIC_HOST=
# Electrum listeners inside the container; "off" disables one.
#FRIGLET_UI_ELECTRUM_TCP=0.0.0.0:50031
#FRIGLET_UI_ELECTRUM_TLS=0.0.0.0:50032
# password (default) or none (only behind your own authenticating proxy; shows a warning).
#FRIGLET_UI_AUTH=password
#FRIGLET_UI_LOG=info

# --- Compose only ---------------------------------------------------------------------------
# Image; the default is the release this compose file belongs to.
#FRIGLET_NODE_IMAGE=friglet-node:dev
# Host address and ports to publish on. 127.0.0.1 keeps everything on this machine.
#BIND_ADDRESS=0.0.0.0
#UI_PORT=8097
#ELECTRUM_PORT=50031
#ELECTRUM_TLS_PORT=50032
