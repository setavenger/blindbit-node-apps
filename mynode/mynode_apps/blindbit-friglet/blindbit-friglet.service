# blindbit-friglet service
# /etc/systemd/system/blindbit-friglet.service

[Unit]
Description=Friglet (BlindBit Silent Payments Electrum server)
Wants=www.service docker_images.service bitcoin.service
After=www.service docker_images.service bitcoin.service

[Service]
WorkingDirectory=/opt/mynode/blindbit-friglet

ExecStartPre=/usr/bin/is_not_shutting_down.sh
ExecStartPre=/usr/bin/wait_on_bitcoin.sh
ExecStartPre=/usr/bin/wait_on_docker_image_install.sh
# Runs as root ("+"): creates the data folder, the login password and the runtime settings
ExecStartPre=+/bin/bash -c 'if [ -f /usr/bin/service_scripts/pre_blindbit-friglet.sh ]; then /bin/bash /usr/bin/service_scripts/pre_blindbit-friglet.sh; fi'
ExecStartPre=-/usr/local/bin/docker-compose down --remove-orphans
ExecStart=/usr/local/bin/docker-compose up
ExecStartPost=/bin/bash -c 'if [ -f /usr/bin/service_scripts/post_blindbit-friglet.sh ]; then /bin/bash /usr/bin/service_scripts/post_blindbit-friglet.sh; fi'
# friglet-ui gives friglet up to 120 s to save its scan state; compose waits 150 s (stop_grace_period)
ExecStop=/usr/local/bin/docker-compose down --remove-orphans

User=bitcoin
Group=bitcoin
Type=simple
TimeoutStartSec=120
TimeoutStopSec=180
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blindbit-friglet

[Install]
WantedBy=multi-user.target
